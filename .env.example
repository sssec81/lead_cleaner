# LeadCleanr environment variables

# Google Analytics 4 Measurement ID, for example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional canonical site URL, for example: https://leadcleanr.com
# Leave empty to use the built-in default site URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional webhook endpoint for client error reporting.
# If left empty, reported client errors fall back to server logs.
ERROR_TRACKING_WEBHOOK_URL=

# Recommended in production for durable waitlist storage.
# LeadCleanr will POST the qualified Pro waitlist payload to this endpoint:
# { email, role, fileSize, crm, frequency, intendedUse, source, receivedAt }
WAITLIST_WEBHOOK_URL=

# Optional single-server fallback for waitlist storage.
# Leave empty on serverless deployments.
WAITLIST_FILE_PATH=
